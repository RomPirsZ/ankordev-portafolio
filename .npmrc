# Cadena de suministro (plan §8)
# Ninguna dependencia ejecuta scripts al instalarse: es la vía habitual de los paquetes
# comprometidos. Hoy ninguna los necesita en Linux; si una nueva los requiere, se decide aparte.
ignore-scripts=true
# Solo versiones publicadas hace 7 días o más: da tiempo a que se detecte una versión maliciosa.
# Parche urgente: npm install <paquete>@<versión> --min-release-age=0
min-release-age=7
# Dependencias solo desde el registro de npm: nada desde git, URLs, archivos o carpetas
allow-git=none
allow-remote=none
allow-file=none
allow-directory=none
