# Copia a .env y completa. Nunca subas .env al repositorio.
# En producción se configuran en Vercel (Project → Settings → Environment Variables).

# Supabase (Project Settings → API Keys): la clave publishable (sb_publishable_…)
# o la anon heredada, ambas con el rol anon. Nunca la secreta ni service_role.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
# Única variable pública: se expone al navegador
PUBLIC_TURNSTILE_SITE_KEY=
