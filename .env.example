# Copia a .env y completa. Nunca subas .env al repositorio.
# En producción se configuran en Vercel (Project → Settings → Environment Variables).

# Supabase (Project Settings → API Keys): la clave publishable (sb_publishable_…)
# o la anon heredada, ambas con el rol anon. Nunca la secreta ni service_role.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Cloudflare Turnstile. En local, las claves oficiales de prueba (siempre pasan);
# las reales solo en Vercel (plan §7)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Única variable pública: se expone al navegador
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Resend: aviso por email de cada contacto (plan §7). Clave con permiso «Sending access».
# Sin dominio propio, Resend solo entrega en el email de la cuenta: ese va en CONTACT_NOTIFY_TO.
RESEND_API_KEY=
CONTACT_NOTIFY_TO=
