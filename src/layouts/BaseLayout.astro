---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GradientBackground from '../components/GradientBackground';
import { DEFAULT_THEME, THEMES, THEME_STORAGE_KEY } from '../lib/themes';
import { useTranslations, type Lang } from '../i18n/utils';
import { SITE_URL } from '../lib/site';
// Fuentes precargadas: el titular (Space Grotesk, el LCP) y la mono de menú y etiquetas,
// que con `optional` (global.css) solo se usa si llega a tiempo. Vite les da la misma URL
// con hash que en el CSS.
import groteskUrl from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import kryptonUrl from '@fontsource/monaspace-krypton/files/monaspace-krypton-latin-400-normal.woff2?url';

interface Props {
  title: string;
  /** Meta description y Open Graph (T32): 140–160 caracteres en el inicio */
  description: string;
  lang?: Lang;
  /** URL equivalente en el otro idioma */
  altHref?: string;
  /** Páginas que no deben aparecer en buscadores (p. ej., la de gracias) */
  noindex?: boolean;
  /** `article` en los casos de estudio */
  type?: 'website' | 'article';
}

const { title, description, lang = 'es', altHref, noindex = false, type = 'website' } = Astro.props;
const t = useTranslations(lang);

// SEO (T32, plan §10). URLs absolutas: los buscadores y las vistas previas no resuelven rutas.
const site = Astro.site ?? new URL(SITE_URL);
const absolute = (path: string) => new URL(path, site).href;
const canonical = absolute(Astro.url.pathname);
// Cada página existe en los dos idiomas; altHref es la del otro
const hrefs = { es: lang === 'es' ? canonical : altHref && absolute(altHref), en: lang === 'en' ? canonical : altHref && absolute(altHref) };
const ogImage = absolute(`/og/og-${lang}.png`);
const OG_LOCALE = { es: 'es_VE', en: 'en_US' } as const satisfies Record<Lang, string>;
---

<html lang={lang} data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      El sitio tiene tema oscuro propio: Dark Reader se desactiva con esta etiqueta.
      Sin ella oscurecía el tema claro al recargar, borraba el gradiente y seguía
      activo al volver al oscuro (solo quedaba la retícula).
    */}
    <meta name="darkreader-lock" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          {hrefs.es && <link rel="alternate" hreflang="es" href={hrefs.es} />}
          {hrefs.en && <link rel="alternate" hreflang="en" href={hrefs.en} />}
          {hrefs.es && <link rel="alternate" hreflang="x-default" href={hrefs.es} />}
        </>
      )
    }
    <link rel="preload" href={groteskUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={kryptonUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Vista previa al compartir (WhatsApp, redes): imagen 1200×630 por idioma */}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={t('site.brand')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:locale:alternate" content={OG_LOCALE[lang === 'es' ? 'en' : 'es']} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('og.alt')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t('og.alt')} />
    <slot name="head" />
    {/* Transiciones entre páginas (T19); Astro las desactiva con reduced-motion */}
    <ClientRouter />
    {/*
      Antes del primer pintado: aplica el tema guardado y, si hay movimiento,
      marca la página para que las entradas animadas nazcan ocultas (global.css).
      Si cambia este script, cambia su hash en la CSP de public/_headers.
    */}
    <script is:inline define:vars={{ themes: THEMES, key: THEME_STORAGE_KEY }}>
      try {
        const saved = localStorage.getItem(key);
        if (themes.includes(saved)) document.documentElement.dataset.theme = saved;
      } catch {}
      if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        document.documentElement.classList.add('motion');
      }
    </script>
  </head>
  <body class="lab-grid flex min-h-dvh flex-col text-fg">
    {/*
      Sin bg-bg: <html> pinta el color del tema y .gradient-bg, encima, el gradiente estático,
      el canvas (si lo hay) y el grano (global.css).
      Fondo animado (plan §6.1): su JS solo se descarga en escritorio con puntero fino
      y sin reduced-motion. Persiste entre páginas para no reiniciarse al navegar.
    */}
    <div class="gradient-bg" aria-hidden="true" transition:persist="gradient-bg">
      <GradientBackground client:media="(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)" />
    </div>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-accent focus:px-4 focus:py-2 focus:text-on-accent"
    >
      {t('nav.skip')}
    </a>
    <Nav lang={lang} altHref={altHref} />
    <main id="contenido" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import { startMotion } from '../lib/motion';
      startMotion();
    </script>
  </body>
</html>
