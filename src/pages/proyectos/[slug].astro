---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import { localizePath, useTranslations } from '../../i18n/utils';
import { projectSlug, selectProjects } from '../../lib/projects';

export async function getStaticPaths() {
  return selectProjects(await getCollection('projects'), 'es').map((entry) => ({
    params: { slug: projectSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const t = useTranslations('es');
---

<BaseLayout
  title={`${entry.data.title} — ${t('site.brand')}`}
  lang="es"
  altHref={localizePath('project', 'en', { slug: projectSlug(entry.id) })}
>
  <CaseStudy entry={entry} />
</BaseLayout>
