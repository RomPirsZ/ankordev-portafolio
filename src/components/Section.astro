---
// Sección del inicio, en una sola columna centrada (2026-11-13: sin columna de margen; la
// etiqueta `[ 02 / SERVICIOS ]` repetía el título). El título lleva el efecto scramble de
// las etiquetas de laboratorio con su propia tipografía: el texto animado es aria-hidden y
// los lectores de pantalla leen la copia oculta, así que el efecto no les afecta.

interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="border-t border-line">
  <div class="content-grid py-16 md:py-24">
    <h2 id={`${id}-title`} class="text-3xl font-bold tracking-tight text-balance md:row-start-1 md:justify-self-start">
      <span class="sr-only">{title}</span>
      <span aria-hidden="true" data-scramble>{title}</span>
    </h2>
    {
      Astro.slots.has('actions') && (
        <div class="mt-6 md:row-start-1 md:mt-0 md:self-center md:justify-self-end">
          <slot name="actions" />
        </div>
      )
    }
    <div class="mt-8 md:mt-12">
      <slot />
    </div>
  </div>
</section>
