---
import type { Theme } from '../lib/themes';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
// Orden visual habitual: claro a la izquierda, oscuro a la derecha
const options: Theme[] = ['claro', 'oscuro'];
---

{/* Interruptor claro/oscuro. Sin JS no puede funcionar: nace oculto y el script lo muestra */}
<div class="theme-switcher" role="group" aria-label={t('theme.label')} hidden>
  {
    options.map((theme) => (
      <button type="button" data-theme-value={theme} aria-pressed="false" title={t(`theme.${theme}`)}>
        {theme === 'claro' ? (
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
            <circle cx="8" cy="8" r="2.75" />
            <path d="M8 1v1.75M8 13.25V15M1 8h1.75M13.25 8H15M3.05 3.05l1.24 1.24M11.71 11.71l1.24 1.24M3.05 12.95l1.24-1.24M11.71 4.29l1.24-1.24" />
          </svg>
        ) : (
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
            <path d="M13.5 9.6A5.75 5.75 0 0 1 6.4 2.5a5.75 5.75 0 1 0 7.1 7.1Z" />
          </svg>
        )}
        <span class="sr-only">{t(`theme.${theme}`)}</span>
      </button>
    ))
  }
</div>

<style>
  /* Mismo lenguaje que el control de vista: borde de 1 px y el activo invertido */
  .theme-switcher {
    display: inline-flex;
    border: 1px solid var(--fg);
  }

  .theme-switcher[hidden] {
    display: none;
  }

  .theme-switcher button {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    color: var(--fg);
    cursor: pointer;
  }

  .theme-switcher button + button {
    border-left: 1px solid var(--fg);
  }

  .theme-switcher button[aria-pressed='true'] {
    background-color: var(--fg);
    color: var(--bg);
  }

  .theme-switcher svg {
    width: 1rem;
    height: 1rem;
  }
</style>

<script>
  import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';
  import { DEFAULT_THEME, THEME_STORAGE_KEY, isTheme } from '../lib/themes';

  const root = document.documentElement;

  function sync() {
    const current = root.dataset['theme'] ?? DEFAULT_THEME;
    document.querySelectorAll<HTMLButtonElement>('[data-theme-value]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset['themeValue'] === current));
    });
  }

  // Cada página (también tras una View Transition) muestra el selector y marca el tema activo
  function setup() {
    document.querySelectorAll<HTMLElement>('.theme-switcher').forEach((group) => (group.hidden = false));
    sync();
  }

  // Delegación: sigue funcionando aunque el <body> se sustituya al navegar
  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('.theme-switcher [data-theme-value]');
    const theme = button?.dataset['themeValue'];
    if (!isTheme(theme)) return;
    root.dataset['theme'] = theme;
    try {
      localStorage.setItem(THEME_STORAGE_KEY, theme);
    } catch {}
    sync();
  });

  // El <html> de la página nueva trae el tema por defecto: se le pasa el actual antes del cambio
  document.addEventListener('astro:before-swap', (event) => {
    const { newDocument } = event as TransitionBeforeSwapEvent;
    newDocument.documentElement.dataset['theme'] = root.dataset['theme'] ?? DEFAULT_THEME;
  });

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
