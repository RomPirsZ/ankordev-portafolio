---
import SocialIcon from './SocialIcon.astro';
import { SOCIALS } from '../lib/site';
import { formatCaracasTime } from '../lib/clock';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const socials = SOCIALS.filter((social) => social.url);
---

<footer class="border-t border-line">
  <div class="page-frame grid gap-6 py-8 font-mono text-xs uppercase tracking-wider sm:grid-cols-3">
    <p>
      <span class="text-muted">{t('footer.clock')}</span>
      {/* Sin JS queda la hora del build; el script la mantiene al día */}
      <time class="block text-base tabular-nums" data-clock data-lang={lang}>
        {formatCaracasTime(new Date(), lang).slice(0, 5)} UTC−4
      </time>
    </p>

    {
      socials.length > 0 && (
        <nav aria-label={t('footer.social')}>
          {/* -my-1 compensa el py-1 de los enlaces: el texto se alinea con el reloj y el crédito */}
          <ul class="-my-1 flex flex-wrap gap-x-5 gap-y-1">
            {socials.map((social) => (
              <li>
                {/* py-1: el área táctil llega a 24 px de alto (WCAG 2.2, 2.5.8) */}
                <a href={social.url} rel="me noopener" class="group inline-flex items-center gap-2 py-1">
                  <SocialIcon name={social.name} />
                  <span class="group-hover:underline">{social.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <p class="sm:col-start-3 sm:text-right">
      {t('footer.copyright', { year: new Date().getFullYear() })}{' '}
      {/* La marca se escribe tal cual, aunque la etiqueta vaya en mayúsculas */}
      <span class="normal-case">{t('site.brand')}</span>
    </p>
  </div>
</footer>

<script>
  import { formatCaracasTime } from '../lib/clock';

  // Se buscan los relojes en cada tic: tras una View Transition el pie es otro
  function tick() {
    const now = new Date();
    document.querySelectorAll<HTMLTimeElement>('[data-clock]').forEach((clock) => {
      clock.textContent = `${formatCaracasTime(now, clock.dataset['lang'] === 'en' ? 'en' : 'es')} UTC−4`;
      clock.dateTime = now.toISOString();
    });
  }

  tick();
  setInterval(tick, 1000);
  document.addEventListener('astro:after-swap', tick);
</script>
