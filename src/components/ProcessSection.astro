---
// Proceso (spec §5.5): Descubrir → Especificar → Construir → Lanzar. Una línea une
// las marcas de los pasos; con movimiento se dibuja al hacer scroll (spec §7,
// effects/process.ts). Sin JS o con reduced-motion se ve entera. Vertical en móvil,
// horizontal desde 64rem.
import Section from './Section.astro';
import { sectionId, sectionNumber, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const STEPS = ['discover', 'specify', 'build', 'launch'] as const;
---

<Section id={sectionId('process', lang)} number={sectionNumber('process')} title={t('process.title')}>
  <div class="process" data-process>
    <ol class="process-steps" role="list">
      {
        STEPS.map((id, i) => (
          <li class="step">
            {i < STEPS.length - 1 && <span class="step-line" aria-hidden="true" />}
            <span class="step-number annotation" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="step-name">{t(`process.${id}.name`)}</h3>
            <p class="step-text">{t(`process.${id}.text`)}</p>
          </li>
        ))
      }
    </ol>
  </div>
</Section>

<style>
  /* --progress (0 → 1) es el avance de toda la línea: 1 por defecto, así sin JS se ve
     completa. Cada tramo toma su parte: el primero de 0 a 1/3, el segundo de 1/3 a 2/3… */
  .process {
    --progress: 1;
    --segments: 3;
  }

  /* Orden de cada tramo. Sin atributos style: la CSP no los permite */
  .step:nth-child(2) {
    --i: 1;
  }

  .step:nth-child(3) {
    --i: 2;
  }

  .process-steps {
    display: grid;
    gap: 2.5rem;
  }

  .step {
    --i: 0;
    position: relative;
    display: grid;
    row-gap: 0.5rem;
    padding-left: 2rem;
  }

  /* Marca de cada paso: un cuadrado (el círculo es solo para estados) */
  .step::before {
    content: '';
    position: absolute;
    top: 0.2rem;
    left: 0;
    z-index: 1;
    width: 0.5625rem;
    height: 0.5625rem;
    background-color: var(--fg);
  }

  /* Tramo de 1 px hasta la marca siguiente: riel en --line y avance en --fg encima */
  .step-line {
    position: absolute;
    top: 0.48rem;
    left: 0.25rem;
    width: 1px;
    height: calc(100% + 2.5rem);
    background-color: var(--line);
  }

  .step-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--fg);
    transform: scaleY(clamp(0, var(--progress) * var(--segments) - var(--i), 1));
    transform-origin: top;
  }

  .step-name {
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .step-text {
    max-width: 40ch;
    color: var(--muted);
    text-wrap: pretty;
  }

  @media (width >= 64rem) {
    .process-steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .step {
      padding-top: 2rem;
      padding-left: 0;
    }

    .step::before {
      top: 0;
    }

    .step-line {
      top: 0.25rem;
      left: 0.25rem;
      width: calc(100% + 1.5rem);
      height: 1px;
    }

    .step-line::after {
      transform: scaleX(clamp(0, var(--progress) * var(--segments) - var(--i), 1));
      transform-origin: left;
    }
  }
</style>
