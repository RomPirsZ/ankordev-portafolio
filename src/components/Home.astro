---
// Contenido del inicio, común a / y /en/, en el orden de la spec §5.
import ArrowIcon from './ArrowIcon.astro';
import ProjectsSection from './ProjectsSection.astro';
import ServicesSection from './ServicesSection.astro';
import ProcessSection from './ProcessSection.astro';
import AboutSection from './AboutSection.astro';
import ContactSection from './ContactSection.astro';
import { sectionHref, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// El titular son dos frases: cada una empieza en su propia línea y equilibra sus cortes
const heroSentences = t('hero.title').split(/(?<=\.)\s+/);
---

<section aria-labelledby="hero-title" class="margin-grid min-h-[72svh] content-end pt-16 pb-14 md:pb-20">
  <h1 id="hero-title" class="max-w-[14ch] text-display font-bold text-balance md:col-start-2" data-split>
    {heroSentences.map((sentence, i) => [i > 0 ? ' ' : null, <span class="hero-sentence block">{sentence}</span>])}
  </h1>
  <p class="mt-4 max-w-[46ch] text-lg text-pretty md:col-start-2 md:mt-8">{t('hero.subtitle')}</p>
  <!-- El único bloque sólido de la pantalla (DESIGN.md, sólido + fino) y, al lado, el estado -->
  <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-5 md:col-start-2 md:mt-10">
    <a
      href={sectionHref('contact', lang)}
      class="inline-flex items-center gap-3 bg-accent px-6 py-4 text-lg font-bold text-on-accent"
      data-magnetic
    >
      {t('hero.cta')}
      <ArrowIcon />
    </a>
    <p class="annotation flex items-center gap-2.5 text-fg">
      <span class="size-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
      {t('hero.available')}
    </p>
  </div>
</section>

<ProjectsSection lang={lang} />
<ServicesSection lang={lang} />
<ProcessSection lang={lang} />
<AboutSection lang={lang} />
<ContactSection lang={lang} />
