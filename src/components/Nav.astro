---
import Logo from './Logo.astro';
import ThemeSwitcher from './ThemeSwitcher.astro';
import { alternateLang, localizePath, sectionHref, useTranslations, type Lang, type Section } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** URL de esta página en el otro idioma; sin ella no se muestra el cambio de idioma */
  altHref?: string | undefined;
}

const { lang, altHref } = Astro.props;
const t = useTranslations(lang);
const home = localizePath('home', lang);
const otherLang = alternateLang(lang);

// Orden del menú (spec §5). Solo se enlazan las secciones que ya existen en el inicio:
// Servicios, Sobre mí y Contacto vuelven con T12.
const NAV_SECTIONS = ['projects', 'services', 'about', 'contact'] as const;
const BUILT_SECTIONS: readonly Section[] = ['projects'];

const links = NAV_SECTIONS.filter((section) => BUILT_SECTIONS.includes(section)).map((section) => ({
  href: sectionHref(section, lang),
  label: t(`nav.${section}`),
}));
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4 sm:px-6">
    <!-- py-2: el área táctil del logo llega a 38 px de alto -->
    <a href={home} class="block py-2">
      <Logo />
      <span class="sr-only">{t('site.brand')} — {t('nav.home')}</span>
    </a>

    <nav aria-label={t('nav.label')} class="order-last w-full sm:order-none sm:w-auto">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs uppercase tracking-wider">
        {
          links.map((link, i) => (
            <li>
              <a href={link.href} class="inline-block py-1 hover:underline">
                <span class="text-muted" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span> {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-4">
      <ThemeSwitcher lang={lang} />
      {
        altHref && (
          <a href={altHref} hreflang={otherLang} lang={otherLang} class="font-mono text-xs uppercase tracking-wider hover:underline">
            <span aria-hidden="true">{otherLang}</span>
            <span class="sr-only">{t('nav.lang')}</span>
          </a>
        )
      }
    </div>
  </div>
</header>
